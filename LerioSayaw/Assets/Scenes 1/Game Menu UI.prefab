  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 56
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 56
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Meet the Group Meet the Group (Images)\r\nAlmilyn Mae C. Malaza\r\nJohn
    Joshua B. Sazon\r\nArjet R. Millan\r\n\nMission\r\nOur mission is to preserve
    and promote the rich cultural heritage of Filipino folk dances, particularly
    the Lerion and Cari\xF1osa, through innovative virtual reality experiences. We
    aim to make traditional dance education accessible and immersive, empowering
    users to engage deeply with the dances while appreciating their cultural significance.\r\n\n\n\nGoal\r\nOur
    goal is to develop a virtual reality application that not only teaches the steps
    and movements of Lerion and Cari\xF1osa but also provides a deeper understanding
    of the cultural history behind these dances. By offering an engaging and interactive
    platform, we aim to bridge the gap between modern technology and traditional
    art forms, fostering appreciation and participation across generations.\r\n\n"
