  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 26
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 51
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Objective Explanation\n\n\nThe project focuses on developing a Virtual
    Reality (VR) application for learning Philippine folk dances, particularly Lerion
    and Cari\xF1osa. Using 3D graphics, it provides an immersive and interactive
    environment where users can practice dance steps, receive feedback, and explore
    the cultural significance of these dances. The application will be evaluated
    based on the ISO/IEC 25010 model to ensure it adheres to established quality
    standards. By combining technology with cultural education, this VR application
    promotes the preservation of Filipino heritage and offers a modern approach to
    learning traditional dances."
