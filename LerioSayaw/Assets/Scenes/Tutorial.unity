  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'The player must mimic the shape of the wall they are standing on by matching
    their movements accordingly. Each new wall presents a specific stance or step
    that the player must replicate. Scoring is based on accuracy: a Perfect earns
    2 points, a Great earns 1 point, and every 5 misses results in a deduction of
    2 points. Each miss deducts 1 point. The first 5 incorrect steps result in a
    score of 0. If the player gets 10 consecutive incorrect steps, the game is over.
    For every 5 consecutive correct steps (a mix of Perfect and Great), the player
    earns a +5 bonus.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: a6446991ef31ced4190c53c206cf4b3e, type: 2}
  m_sharedMaterial: {fileID: -9221056233183343877, guid: a6446991ef31ced4190c53c206cf4b3e, type: 2}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
